{
  "$schema": "node_modules/diff2prompt/dist/schema.json",
  "outputPath": "generated-prompt.txt",
  "promptTemplateFile": "prompts/diff2prompt-pr-ja.md",
  "includeUntracked": true,
  "maxConsoleLines": 30,
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "target",
    ".gradle",
    ".tools",
    "generated-prompt.txt"
  ],
  "gitignoreFile": ".gitignore"
}
