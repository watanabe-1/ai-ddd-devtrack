{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.gradle/**",
    "**/coverage/**"
  ],
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "jsdoc": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": {
    "order": "asc",
    "newlinesBetween": false,
    "groups": [
      ["builtin", "type-builtin", "external", "type-external"],
      { "newlinesBetween": true },
      [
        "internal",
        "type-internal",
        "subpath",
        "type-subpath",
        "parent",
        "type-parent",
        "sibling",
        "type-sibling",
        "index",
        "type-index"
      ],
      "style",
      "unknown"
    ]
  }
}
